# Mukham Service Configuration for Dev Environment
# Source this after dev.env to extend configuration

# Mukham ECS Configuration
MUKHAM_CPU=512
MUKHAM_MEMORY=1024
MUKHAM_PORT=3000
NODE_ENV=development

# Mukham Application Configuration
NEXT_PUBLIC_API_URL=http://your-mukham-alb-dns
NEXTAUTH_SECRET=change_me_mukham_auth_secret_dev
NEXTAUTH_URL=http://your-mukham-alb-dns

# OAuth Configuration (can reuse from main config)
GOOGLE_CLIENT_ID=${GOOGLE_OAUTH_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_OAUTH_CLIENT_SECRET}
